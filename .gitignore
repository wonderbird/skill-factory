# Beads: track only the issue export, the config and the project metadata;
# see CLAUDE.md.
.beads/*
!.beads/issues.jsonl
!.beads/config.yaml
!.beads/metadata.json

# bv (beads viewer) local config and caches
.bv/

# Git Worktrees
.worktrees/

# Oh My Claude Code
**/.omc/state/
**/.omc/sessions/
.omc/prd.json
.omc/project-memory.json
.omc/progress.txt

# Skills are managed via https://github.com/omrikais/skill-manager
# See .skills.json. skill-manager symlinks project-scope skills into these
# directories; list every project-scope skill here. User-scope skills live
# outside the repository and need no entry.
.agents
.claude/skills/commit
.claude/skills/fix-problem
.claude/skills/flow-consultant
.claude/skills/format-markdown
.claude/skills/record-findings

# Oh My OpenAgent (OMO) — per-session agent state, e.g. run-continuation/.
# Upstream ignores the contents of this directory and whitelists only durable
# artefacts: https://github.com/code-yeongyu/oh-my-openagent/blob/dev/.gitignore
#
# Written as `.omo/*`, not `.omo/`: a directory-pattern ignore blocks every
# later negation from every ignore file, so the contents form is what keeps a
# future whitelist entry possible — the same reason `.beads/*` is written that
# way above.
.omo/*

# Secrets. These patterns are deliberately broad and fail safe: a legitimate
# file whose name contains "password" or "secrets" is ignored too. Find the
# matching rule with `git check-ignore -v <path>` and add a `!` exception.
*.pem
*password*
*secrets*
# .env, .envrc and others are considered in the rules of the original repo
# below.

# Oh My Claude Code state - block all, then carve out what to share
!.omc/
.omc/*
!.omc/skills/
!.omc/skills/**
!.omc/project-memory.json

